#!/bin/sh
# Clean generated OpenFOAM mesh and results while preserving the case setup.
set -eu

# Always operate in the directory containing this script. This makes
# "./AllClean" safe to call from any current working directory.
cd "$(dirname "$0")"

# Remove calculated time directories (100, 200, ..., 500), but keep the
# initial-condition directory 0. foamListTimes is supplied by OpenFOAM.
foamListTimes -rm -noZero

# These directories are generated by blockMesh/snappyHexMesh, function
# objects, and foamToVTK. They will be recreated on the next run.
rm -rf \
    constant/polyMesh \
    postProcessing \
    VTK

# snappyHexMesh writes these diagnostic refinement fields into time 0 when
# writeFlags contains scalarLevels. They are not initial conditions.
rm -f \
    0/cellLevel \
    0/pointLevel

# Restore the reference initial velocity field. foamRun normally does not
# modify 0/U, but this guarantees a reproducible clean state if 0/U was edited
# manually or changed by another utility between runs.
cp 0/U.orig 0/U

# Remove the standard log files if OpenFOAM commands were run with log output.
find . -maxdepth 1 -type f -name 'log.*' -delete

echo "Cleaned generated mesh and results in: $(pwd)"
echo "Restored: 0/U from 0/U.orig"
echo "Preserved: 0/, constant/geometry/, system/, Allrun"
