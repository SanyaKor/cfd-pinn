FoamFile
{
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}

convertToMeters 1;

// Thin 3D slab around the supplied 2d.stl.  snappyHexMesh requires a fully
// 3D background mesh, therefore the two thin-direction patches are symmetry.
vertices
(
    (0.02010 -0.10 -0.001)
    (0.02095 -0.10 -0.001)
    (0.02095  0.10 -0.001)
    (0.02010  0.10 -0.001)
    (0.02010 -0.10  0.050)
    (0.02095 -0.10  0.050)
    (0.02095  0.10  0.050)
    (0.02010  0.10  0.050)
);

blocks
(
    hex (0 1 2 3 4 5 6 7) (1 40 20) simpleGrading (1 1 1)
);

boundary
(
    outlet
    {
        type patch;
        faces ((3 7 6 2));
    }
    sideMin
    {
        type symmetryPlane;
        faces ((0 4 7 3));
    }
    sideMax
    {
        type symmetryPlane;
        faces ((1 2 6 5));
    }
    ground
    {
        type wall;
        faces ((0 3 2 1));
    }
    inlet
    {
        type patch;
        faces ((1 5 4 0));
    }
    top
    {
        type patch;
        faces ((4 5 6 7));
    }
);

